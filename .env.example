# 복사해서 .env로 만든 뒤 값을 채운다. .env는 커밋하지 않는다.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# smartfarm-ai 진단 서비스 주소. 기본값(http://localhost:8000)과 다를 때만 주석을 풀고 채운다.
# AI_SERVICE_URL=http://localhost:8000
# AI 서버에 API_KEY를 설정했다면 같은 값을 넣는다 (X-API-Key 헤더로 전송).
# AI_SERVICE_API_KEY=
